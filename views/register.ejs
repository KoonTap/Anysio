<%# หน้าสมัคร Owner: แสดงข้อผิดพลาดและคืนค่าชื่อที่กรอก; ไม่คืนค่ารหัสผ่าน %>

<%- include('partials/header') %>

<section class="login-art">
  <a class="brand" href="/">✚ anysio.</a>
  <div class="login-copy">
    <span class="eyebrow">A LITTLE CARE. A BETTER LIFE.</span>
    <h1>Register</h1>
    <p>สร้างบัญชีเพื่อเพิ่มสัตว์เลี้ยง ขอนัดหมาย
      <br>และติดตามผลตรวจของสัตว์ที่คุณรัก
    </p>
    <div class="pet-illustration login-dog-art">
      <img class="banner-dog login-dog" src="/static/images/dashboard-dog.png?v=3"
        alt="สุนัขมาสคอต ANYSIO" width="1436" height="1096">
    </div>
  </div>
  <p class="login-footnote">ระบบนัดหมายคลินิกสัตว์เลี้ยง · anysio</p>
</section>
<section class="login-form">
  <span class="eyebrow">WELCOME TO ANYSIO</span>

  <%# ส่วน สมัครสมาชิก: เนื้อหาและช่องกรอกที่เกี่ยวข้องอยู่ถัดจากหัวข้อนี้ %>
  <h2>สมัครสมาชิก</h2>
  <p class="muted">สำหรับเจ้าของสัตว์เลี้ยง</p>

  <% if (error) { %>

    <p class="auth-message auth-message-error" role="alert"><%= error %></p>

  <% } %>

  <%# ส่งข้อมูลสมัครสมาชิก; Server กำหนด Role เป็น Owner โดยไม่รับ Role จากฟอร์ม %>
  <form method="post" action="/register">

    <%# ส่ง Token ของ Session ไปให้ CSRF Middleware ตรวจ ก่อนอนุญาตให้ทำรายการ %>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>ชื่อที่แสดง
      <input name="full_name" autocomplete="name" required maxlength="150"
        value="<%= values.full_name || '' %>" placeholder="ชื่อของคุณ">
    </label>
    <label>ชื่อผู้ใช้
      <input name="username" autocomplete="username" required minlength="3" maxlength="60"
        pattern="[a-zA-Z0-9_.\-]+" value="<%= values.username || '' %>"
        aria-describedby="username-help" placeholder="เช่น somchai_01">
    </label>
    <p id="username-help" class="form-note">3–60 ตัว ใช้ภาษาอังกฤษ ตัวเลข จุด ขีดกลาง หรือขีดล่าง
    </p>
    <label>รหัสผ่าน
      <input type="password" name="password" autocomplete="new-password" required minlength="8"
        maxlength="72" aria-describedby="password-help">
    </label>
    <p id="password-help" class="form-note">อย่างน้อย 8 ตัวอักษร</p>
    <label>ยืนยันรหัสผ่าน
      <input type="password" name="confirm_password" autocomplete="new-password" required
        minlength="8" maxlength="72">
    </label>
    <button class="button wide" type="submit">สมัครสมาชิก <span>→</span>
    </button>
  </form>
  <p class="form-note">มีบัญชีแล้ว? <a href="/login">เข้าสู่ระบบ</a>
  </p>
</section>

<%- include('partials/footer') %>
